{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Robot: Build",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/pio.ps1", "run"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Robot: Upload",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/pio.ps1", "run", "--target", "upload"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Robot: Monitor",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/pio.ps1", "device", "monitor"],
      "problemMatcher": []
    }
  ]
}
